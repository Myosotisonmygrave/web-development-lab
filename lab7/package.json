{
  "name": "web-development-lab7",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "sass:dev": "sass --style=expanded --source-map scss/main.scss css/style.css",
    "sass:watch": "sass --watch --style=expanded --source-map scss/main.scss css/style.css",
    "sass:build": "sass --style=compressed --no-source-map scss/main.scss css/style.min.css",
    "build": "npm run sass:dev && npm run sass:build"
  },
  "devDependencies": { "sass": "^1.80.0" }
}
